---
import Base from '../layouts/Base.astro';
import { sessionTypes, availability } from '../data/sessions.js';
---
<Base
  title="Schedule 1:1 — Aliaksei Kozel"
  description="Book a 30-, 45-, or 60-minute 1:1 with Aliaksei Kozel — free, on Zoom."
>
  <section class="hair-b hair-soft">
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">Services</p>
      <h1 class="mt-5 max-w-[20ch] text-[clamp(2.2rem,6vw,4.5rem)] font-medium">Schedule 1:1</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        Pick a session type, a date, a time, and a bit of context to share.<br />
        I’ll confirm by reply.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          ['Free', 'Volunteering', 'No strings', 'Donations'].map((tag) => (
            <li class="tag mono px-3 py-1.5">{tag}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="hair-b hair-soft">
    <div class="px-[var(--pad)] pt-14">
      <p class="mono text-brand">In detail</p>
      <h2 class="mt-4 max-w-[16ch] text-[clamp(1.8rem,4vw,3rem)] font-medium">What you bring, what we build</h2>
    </div>
    <div class="grid gap-10 px-[var(--pad)] pt-8 pb-16 md:grid-cols-3 md:gap-y-5">
      {
        sessionTypes.map((t) => (
          <div class="grid content-start gap-5 md:row-span-5 md:grid-rows-subgrid">
            <p class="mono text-muted">{t.audience}</p>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-xl font-medium">{t.name}</h3>
              <span class="mono text-muted">{t.minutes} min</span>
            </div>
            <p class="text-secondary">{t.description}</p>
            <div>
              <p class="mono text-muted">You bring</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {t.bring.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="mono text-muted">We build</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {t.build.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="hair-b hair-soft">
    <div class="grid gap-10 px-[var(--pad)] py-14 md:grid-cols-[0.85fr_1.9fr]" data-schedule>
      <div>
        <p class="mono text-muted">Session</p>
        <div class="mt-4 grid gap-3" data-schedule-types>
          {
            sessionTypes.map((t) => (
              <button
                type="button"
                class="pick-btn p-5 text-left"
                data-type={t.id}
                aria-pressed="false"
              >
                <span class="mono block text-muted">{t.audience}</span>
                <span class="mt-2 flex items-baseline justify-between gap-4">
                  <span class="text-lg font-medium" data-type-name>{t.name}</span>
                  <span class="mono text-muted">{t.minutes} min</span>
                </span>
                <span class="mt-2 block text-sm text-secondary">{t.description}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div>
        <div data-step="slots">
          <div class="flex items-center justify-between gap-4">
            <p class="mono text-muted" data-month-label></p>
            <div class="flex items-center gap-3">
              <div class="flex gap-0.5" data-layout-switch role="group" aria-label="Layout">
                <button type="button" class="seg-btn p-1.5" data-layout="month" aria-pressed="true" aria-label="Month view" title="Month">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                    <path d="M3 9h18M8 2v4M16 2v4"></path>
                  </svg>
                </button>
                <button type="button" class="seg-btn p-1.5" data-layout="week" aria-pressed="false" aria-label="Week view" title="Week">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                    <path d="M3 9h18M9 9v12M15 9v12"></path>
                  </svg>
                </button>
                <button type="button" class="seg-btn p-1.5" data-layout="list" aria-pressed="false" aria-label="List view" title="List">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </button>
              </div>
              <div class="flex items-center gap-0.5" data-month-nav>
                <button type="button" class="icon-btn p-1.5" data-month-prev aria-label="Previous month">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6"></path>
                  </svg>
                </button>
                <button type="button" class="icon-btn p-1.5" data-month-next aria-label="Next month">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M9 6l6 6-6 6"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="mono text-muted">Times in</span>
            <div class="relative" data-tz-picker>
              <button
                type="button"
                class="hair flex w-64 items-center justify-between gap-2 bg-transparent py-1.5 pr-2 pl-3 text-sm"
                data-tz-trigger
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span class="min-w-0 flex-1 truncate text-left" data-tz-label></span>
                <span class="shrink-0 text-muted" data-tz-offset></span>
                <svg class="shrink-0 text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </button>
              <div class="hair absolute z-20 mt-1 hidden w-64 bg-background" data-tz-panel>
                <div class="sticky top-0 bg-background p-2">
                  <input
                    type="text"
                    class="field w-full px-3 py-1.5 text-sm"
                    placeholder="Search a city…"
                    data-tz-search
                    aria-label="Search timezones"
                  />
                </div>
                <ul class="max-h-64 overflow-auto" data-tz-options role="listbox" aria-label="Timezones"></ul>
              </div>
            </div>
          </div>

          <div class="mt-4" data-view="month">
            <div class="grid grid-cols-7 gap-1 text-center">
              {
                ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => (
                  <span class="mono py-2 text-muted">{d}</span>
                ))
              }
            </div>
            <div class="grid grid-cols-7 gap-1 text-center" data-days></div>
            <div class="mt-6" data-times-wrap hidden>
              <p class="mono text-muted" data-times-label></p>
              <div class="mt-3 flex flex-wrap gap-2" data-times></div>
            </div>
          </div>

          <div class="mt-4 hidden" data-view="list">
            <div class="grid gap-6" data-list></div>
          </div>
        </div>

        <form data-step="form" class="hidden grid gap-4" novalidate>
          <p class="mono text-muted">Your details — <span class="text-brand">*</span> required</p>
          <input
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Name *"
            class="field w-full px-4 py-3"
          />
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Email *"
            class="field w-full px-4 py-3"
          />
          <textarea
            name="note"
            rows="3"
            placeholder="What’s on your mind?"
            class="field w-full px-4 py-3"></textarea>
          <p class="text-sm text-brand" data-form-error hidden></p>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn btn--solid mono">Send request</button>
            <button type="button" class="btn mono" data-form-back>Back</button>
          </div>
        </form>

        <div data-step="done" class="hidden">
          <p class="mono text-brand">Requested</p>
          <p class="mt-4 max-w-[46ch] text-lg">
            Thanks — your request is in. I’ll confirm by email shortly, with the Zoom link.
          </p>
          <p class="mono mt-4 text-muted" data-done-summary></p>
          <a class="btn mono mt-6" href="/">← Back home</a>
        </div>
      </div>
    </div>
  </section>

  <script
    type="application/json"
    data-schedule-config
    set:html={JSON.stringify({
      types: sessionTypes.map((t) => ({ id: t.id, name: t.name, minutes: t.minutes })),
      label: availability.label,
      timezone: availability.timezone
    })}
  ></script>
  <script>
    import '../assets/js/schedule.js';
  </script>
</Base>
