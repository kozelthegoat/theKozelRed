---
import Base from '../layouts/Base.astro';
---
<Base title="Schedule a 1:1 — Aliaksei Kozel" description="Book a 30- or 60-minute 1:1.">
  <section class="hair-b">
    <div class="px-[var(--pad)] pt-20 pb-16">
      <p class="mono text-brand">1:1</p>
      <h1 class="mt-6 text-[clamp(2.2rem,6vw,4.5rem)] font-medium">Schedule a 1:1</h1>
      <p class="mt-6 max-w-[46ch] text-secondary">
        Pick a session type and an open time. The booking flow lands next.
      </p>
      <a class="btn mono mt-10" href="/">← Back</a>
    </div>
  </section>
</Base>
