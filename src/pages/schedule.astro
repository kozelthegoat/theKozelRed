---
import Base from '../layouts/Base.astro';
import { sessionTypes, availability } from '../data/sessions.js';
---
<Base
  title="Schedule 1:1 — Aliaksei Kozel"
  description="Book a 30- or 60-minute 1:1 with Aliaksei Kozel."
>
  <section class="hair-b hair-soft">
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">1:1</p>
      <h1 class="mt-5 max-w-[20ch] text-[clamp(2.2rem,6vw,4.5rem)] font-medium">Schedule 1:1</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        Pick a session and a time. I’ll confirm by reply — no payment.
      </p>
    </div>
  </section>

  <section class="hair-b hair-soft">
    <div class="grid gap-10 px-[var(--pad)] py-14 md:grid-cols-[1fr_1.4fr]" data-schedule>
      <div>
        <p class="mono text-muted">Session</p>
        <div class="mt-4 grid gap-3" data-schedule-types>
          {
            sessionTypes.map((t) => (
              <button
                type="button"
                class="type-btn rounded-lg p-5 text-left"
                data-type={t.id}
                aria-pressed="false"
              >
                <span class="flex items-baseline justify-between gap-4">
                  <span class="text-lg font-medium" data-type-name>{t.name}</span>
                  <span class="mono text-muted">{t.minutes} min</span>
                </span>
                <span class="mt-2 block text-sm text-secondary">{t.description}</span>
              </button>
            ))
          }
        </div>
        <p class="mono mt-6 text-muted" data-schedule-summary></p>
      </div>

      <div>
        <div data-step="slots">
          <div class="flex items-center justify-between gap-4">
            <p class="mono text-muted" data-month-label></p>
            <div class="flex gap-2">
              <button type="button" class="btn px-3 py-1.5" data-month-prev aria-label="Previous month">←</button>
              <button type="button" class="btn px-3 py-1.5" data-month-next aria-label="Next month">→</button>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-7 gap-1 text-center">
            {
              ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => (
                <span class="mono py-2 text-muted">{d}</span>
              ))
            }
          </div>
          <div class="grid grid-cols-7 gap-1 text-center" data-days></div>
          <div class="mt-6" data-times-wrap hidden>
            <p class="mono text-muted" data-times-label></p>
            <div class="mt-3 flex flex-wrap gap-2" data-times></div>
          </div>
        </div>

        <form data-step="form" class="hidden grid gap-4" novalidate>
          <p class="mono text-muted">Your details</p>
          <input
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Name"
            class="hair w-full rounded-lg bg-transparent px-4 py-3"
          />
          <input
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="Email"
            class="hair w-full rounded-lg bg-transparent px-4 py-3"
          />
          <textarea
            name="note"
            rows="3"
            placeholder="Anything I should know? (optional)"
            class="hair w-full rounded-lg bg-transparent px-4 py-3"></textarea>
          <p class="text-sm text-brand" data-form-error hidden></p>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn btn--solid mono">Send request</button>
            <button type="button" class="btn mono" data-form-back>Back</button>
          </div>
        </form>

        <div data-step="done" class="hidden">
          <p class="mono text-brand">Requested</p>
          <p class="mt-4 max-w-[46ch] text-lg">
            Thanks — your request is in. I’ll confirm by email shortly.
          </p>
          <p class="mono mt-4 text-muted" data-done-summary></p>
          <a class="btn mono mt-6" href="/">← Back home</a>
        </div>
      </div>
    </div>
  </section>

  <section class="hair-b hair-soft">
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">In detail</p>
      <h2 class="mt-4 text-[clamp(1.8rem,4vw,3rem)] font-medium">What you bring, what you take away</h2>
    </div>
    <div class="grid gap-10 px-[var(--pad)] pb-16 md:grid-cols-3">
      {
        sessionTypes.map((t) => (
          <div class="grid content-start gap-5">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-xl font-medium">{t.name}</h3>
              <span class="mono text-muted">{t.minutes} min</span>
            </div>
            <p class="text-secondary">{t.description}</p>
            <div>
              <p class="mono text-muted">What you can bring</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {t.bring.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="mono text-muted">You leave with</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {t.leave.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">—</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <script
    type="application/json"
    data-schedule-config
    set:html={JSON.stringify({
      types: sessionTypes.map((t) => ({ id: t.id, name: t.name, minutes: t.minutes })),
      label: availability.label
    })}
  ></script>
  <script>
    import '../assets/js/schedule.js';
  </script>
</Base>
