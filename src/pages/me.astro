---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { listParams, listSql, listHref, parsePast } from '../lib/requests.js';
import { availability, sessionTypes } from '../data/sessions.js';
import { wallClockInTz, instantFromSqliteUtc, zoneOffsetLabel, nowInTz } from '../lib/tz.js';
import StatusForm from '../components/StatusForm.astro';
import { linkify } from '../lib/linkify.js';

export const prerender = false;

// Read from the session types themselves, so the table cannot fall out of step with the labels.
const TYPE_NAMES = Object.fromEntries(sessionTypes.map((t) => [t.id, t.name]));

// Display columns, left to right. `sortable` ones come from the whitelist in lib/requests.js.
// Widths are declared, not measured from the page: with content-sized columns the layout moved
// whenever a sort changed which requests were on the page (the `past` marker alone swung the
// When column by 32px). Body takes the remainder.
const COLUMNS = [
  { key: 'slot_date', label: 'When', sortable: true, width: '8.25rem' },
  { key: 'name', label: 'Name', sortable: true, width: '8rem' },
  { key: 'email', label: 'Email', sortable: true, width: '7.5rem' },
  { key: 'type', label: 'Type', sortable: true, width: '7.5rem' },
  { key: 'note', label: 'Message', sortable: false, wide: true },
  { key: 'created_at', label: 'Requested', sortable: true, width: '6rem' }
];
const SORT_LINKS = COLUMNS.filter((c) => c.sortable);

// A long name was the only reason this column was wide. First name over the rest costs no row
// height — the row is two lines anyway — and a two-word name needs about half the width.
const nameLines = (full) => {
  const [first, ...rest] = String(full || '').trim().split(/\s+/);
  return { first: first || '', rest: rest.join(' ') };
};

const db = env?.DB;
const params = Astro.url.searchParams;

// "Today" is the schedule's day, not the server's, and it is the single date the filter
// and the rows are both compared against — so the counts and the list cannot disagree.
const today = nowInTz(availability.timezone).date;

let rows = [];
let total = 0;
let pastCount = 0;
let pending = 0;
let list = listParams(params, 0);

if (db) {
  const counts = await db
    .prepare(
      `SELECT
         COALESCE(SUM(CASE WHEN slot_date >= ? THEN 1 ELSE 0 END), 0) AS upcoming,
         COALESCE(SUM(CASE WHEN slot_date < ? THEN 1 ELSE 0 END), 0) AS past,
         COALESCE(SUM(CASE WHEN status = 'new' AND slot_date >= ? THEN 1 ELSE 0 END), 0) AS pending_upcoming,
         COALESCE(SUM(CASE WHEN status = 'new' THEN 1 ELSE 0 END), 0) AS pending_all
       FROM requests`
    )
    .bind(today, today, today)
    .first();

  const upcoming = Number(counts?.upcoming ?? 0);
  pastCount = Number(counts?.past ?? 0);
  // Every number on the page describes what is on the page: past rows are counted only
  // once the filter is on, so `to review` can never point at something you cannot see.
  total = list.past ? upcoming + pastCount : upcoming;
  pending = list.past ? Number(counts?.pending_all ?? 0) : Number(counts?.pending_upcoming ?? 0);

  list = listParams(params, total);
  const stmt = db.prepare(listSql(list.sort, list.dir, { includePast: list.past }));
  const { results } = await (list.past
    ? stmt.bind(list.pageSize, list.offset)
    : stmt.bind(today, list.pageSize, list.offset)
  ).all();
  // created_at is a UTC instant; the slot columns are already Minsk wall clock. Show both
  // in the zone the site runs on, so a row can be read without converting in your head.
  rows = (results || []).map((r) => ({
    ...r,
    requested: wallClockInTz(instantFromSqliteUtc(r.created_at), availability.timezone),
    nameParts: nameLines(r.name)
  }));
}

// Derived, not hardcoded: follows Europe/Minsk if its rules ever change.
const tzLabel = `${availability.timezone} (${zoneOffsetLabel(availability.timezone)})`;

const typeName = (id) => TYPE_NAMES[id] || id;
const isPast = (d) => d < today;

// Clicking the active column flips direction; a new column starts ascending. Either way
// we go back to page 1, otherwise the page can land past the end of the new order.
const sortHref = (col) =>
  listHref(list, { sort: col, dir: list.sort === col && list.dir === 'asc' ? 'desc' : 'asc', page: 1 });
const ariaSort = (col) =>
  list.sort === col ? (list.dir === 'asc' ? 'ascending' : 'descending') : 'none';
const mark = (col) => (list.sort === col ? (list.dir === 'asc' ? '↑' : '↓') : '');
const statusTone = (s) =>
  s === 'declined' ? 'text-muted line-through' : s === 'new' ? 'text-brand' : 'text-foreground';
---

<Base title="Aliaksei Kozel — 1:1 / Requests" description="1:1 requests.">
  <section>
    <div class="px-[var(--pad)] pt-14 pb-6">
      <p class="mono text-brand">Me</p>
      <h1 class="page-title mt-4">1:1 / Requests</h1>
      <p class="mono mt-3 text-muted">{pending} to review · {total} total</p>
      {(pastCount > 0 || list.past) && (
        <p class="mono mt-2 text-muted">
          <a class="hover:text-brand" href={listHref(list, { past: !list.past, page: 1 })}>
            {list.past ? 'Hide past' : `Show past (${pastCount})`}
          </a>
        </p>
      )}
      <p class="mono mt-2 text-muted">Times in {tzLabel}</p>
    </div>

    <div class="px-[var(--pad)] pb-16">
      {total === 0 && (
        <div class="grid min-h-[52vh] place-items-center pb-16">
          <div class="grid max-w-[38ch] justify-items-center gap-4 text-center">
            <!-- Lucide's inbox mark (lucide-static, ISC — no attribution required). An empty tray
                 says "nothing has arrived" better than the site's own logo does. -->
            <svg
              width="80"
              height="80"
              viewBox="0 0 24 24"
              fill="none"
              stroke="var(--muted)"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              class="mb-1"
            >
              <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
              <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
            </svg>
            {
              !list.past && pastCount > 0 ? (
                <>
                  <p class="mono text-brand">Nothing upcoming</p>
                  <p class="text-secondary">
                    Everything that has come in is in the past — {pastCount}{' '}
                    {pastCount === 1 ? 'request' : 'requests'} hidden by the filter.
                  </p>
                  <p class="mono mt-1">
                    <a
                      class="text-muted hover:text-brand"
                      href={listHref(list, { past: true, page: 1 })}
                    >
                      Show past →
                    </a>
                  </p>
                </>
              ) : (
                <p class="mono text-brand">No requests yet</p>
              )
            }
          </div>
        </div>
      )}

      {
        total > 0 && (
          <>
            {/* narrow screens: same rows as cards, with a sort row standing in for the table header */}
            <div class="mono mb-5 flex flex-wrap gap-x-3 gap-y-2 lg:hidden">
              {SORT_LINKS.map((c) => (
                <a
                  class:list={[
                    // The arrow is out of flow, in the gap: in flow it would change this link's
                    // width as the sort moves, and a wrapping row would re-wrap under your thumb.
                    'relative',
                    list.sort === c.key ? 'text-brand' : 'text-muted hover:text-brand'
                  ]}
                  href={`${sortHref(c.key)}#list`}
                >
                  {c.label}
                  <span class="absolute -right-3 text-brand">{mark(c.key)}</span>
                </a>
              ))}
            </div>

            <div id="list" class="grid gap-4 lg:hidden">
              {rows.map((r) => (
                <article
                  class="hair grid gap-4 p-5"
                  data-new={r.status === 'new' ? 'true' : undefined}
                  data-past={isPast(r.slot_date) ? 'true' : undefined}
                >
                  <div class="grid gap-1">
                    <p class="mono text-muted">
                      <span class={r.status === 'declined' ? 'line-through' : ''}>
                        {r.slot_date} · {r.slot_time}
                      </span>
                      {' · '}
                      {typeName(r.type)}
                    </p>
                    <p class="text-lg font-medium">
                      {r.name}
                      {Number(r.email_count) > 1 && (
                        <span
                          class="mono ml-2 align-middle text-brand"
                          title={`${r.email_count} requests from this address`}
                        >
                          ×{r.email_count}
                        </span>
                      )}
                    </p>
                    <p class="text-sm">
                      <a class="text-secondary hover:text-brand" href={`mailto:${r.email}`}>
                        {r.email}
                      </a>
                    </p>
                    <p class={`mono mt-1 ${statusTone(r.status)}`}>{r.status}</p>
                    {r.note && <p class="mt-1 text-sm text-secondary" set:html={linkify(r.note)} />}
                  </div>
                  <StatusForm
                    request={r}
                    sort={list.sort}
                    dir={list.dir}
                    page={list.page}
                    past={list.past}
                  />
                </article>
              ))}
            </div>

            {/* md and up: the table proper */}
            <div class="hidden lg:block overflow-x-auto">
              <table class="req-table w-full table-fixed border-collapse text-left">
                <thead>
                  <tr class="hair-b">
                    <!-- The sort arrow is absolutely placed inside each cell's padding:
                         in flow it widens whichever header is active, and auto table layout
                         then re-apportions every column, so the row shifts on sort. -->
                    {COLUMNS.map((c) => (
                      <th
                        scope="col"
                        aria-sort={c.sortable ? ariaSort(c.key) : undefined}
                        class={`mono py-3 pr-4 font-normal text-muted ${c.wide ? 'w-full' : ''}`}
                        style={c.width ? `width:${c.width}` : undefined}
                      >
                        {c.sortable ? (
                          <a class="relative whitespace-nowrap hover:text-brand" href={sortHref(c.key)}>
                            {c.label}
                            <span class="absolute -right-3.5 text-brand">{mark(c.key)}</span>
                          </a>
                        ) : (
                          c.label
                        )}
                      </th>
                    ))}
                    <th
                      scope="col"
                      aria-sort={ariaSort('status')}
                      class="mono py-3 text-right font-normal text-muted"
                      style="width:5rem;"
                    >
                      <a class="relative whitespace-nowrap hover:text-brand" href={sortHref('status')}>
                        Status
                        <span class="absolute -right-3.5 text-brand">{mark('status')}</span>
                      </a>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr
                      class="hair-b"
                      data-new={r.status === 'new' ? 'true' : undefined}
                      data-past={isPast(r.slot_date) ? 'true' : undefined}
                    >
                      <td class="py-4 pr-4 text-sm leading-tight whitespace-nowrap">
                        <span class={r.status === 'declined' ? 'text-muted line-through' : ''}>
                          {r.slot_date}
                        </span>
                        <span class="block text-muted">{r.slot_time}</span>
                      </td>
                      <td class="py-4 pr-4 text-sm text-secondary" title={r.name}>
                        <span class="flex items-baseline gap-1.5">
                          <span class="truncate">{r.nameParts.first}</span>
                          {Number(r.email_count) > 1 && (
                            <span
                              class="mono shrink-0 text-brand"
                              title={`${r.email_count} requests from this address`}
                            >
                              ×{r.email_count}
                            </span>
                          )}
                        </span>
                        {r.nameParts.rest && <span class="block truncate">{r.nameParts.rest}</span>}
                      </td>
                      <td class="truncate py-4 pr-4 text-sm" title={r.email}>
                        <a class="text-secondary hover:text-brand" href={`mailto:${r.email}`}>
                          {r.email}
                        </a>
                      </td>
                      <td class="py-4 pr-4 whitespace-nowrap text-sm text-secondary">
                        <span title={typeName(r.type)}>{typeName(r.type)}</span>
                      </td>
                      <td class="w-full py-4 pr-4 text-sm text-secondary">
                        {r.note ? (
                          <>
                            <span
                              class="line-clamp-2 cursor-pointer"
                              data-note
                              title="Show the whole note"
                              set:html={linkify(r.note)}
                            />
                            <button type="button" class="sr-only" data-note-toggle hidden>
                              Show the whole note
                            </button>
                          </>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                      </td>
                      <td class="py-4 pr-4 text-sm leading-tight whitespace-nowrap text-muted">
                        {r.requested.date}
                        <span class="block">{r.requested.time}</span>
                      </td>
                      <td class="py-4 whitespace-nowrap">
                        <StatusForm
                          request={r}
                          sort={list.sort}
                          dir={list.dir}
                          page={list.page}
                          past={list.past}
                          variant="icon"
                        />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* pagination */}
            <div class="hair-t req-pager mt-6 flex items-center justify-between gap-4 pt-4 lg:mt-0">
              <p class="mono text-muted">Page {list.page} of {list.pages}</p>
              <div class="flex items-center gap-2">
                {list.page > 1 ? (
                  <a class="icon-btn p-1.5" href={listHref(list, { page: list.page - 1 })} aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                  </a>
                ) : (
                  <span class="icon-btn pointer-events-none p-1.5 opacity-30" aria-disabled="true" aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                  </span>
                )}
{list.page < list.pages ? (
                  <a class="icon-btn p-1.5" href={listHref(list, { page: list.page + 1 })} aria-label="Next page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M9 6l6 6-6 6"></path>
                    </svg>
                  </a>
                ) : (
                  <span class="icon-btn pointer-events-none p-1.5 opacity-30" aria-disabled="true" aria-label="Next page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M9 6l6 6-6 6"></path>
                    </svg>
                  </span>
                )}
              </div>
            </div>
          </>
        )
      }
    </div>
  </section>
  <script>
    import '../assets/js/notes.js';
  </script>
</Base>
