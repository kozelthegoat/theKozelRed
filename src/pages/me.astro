---
import Base from '../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { listParams, listSql, listHref } from '../lib/requests.js';
import { availability } from '../data/sessions.js';
import { wallClockInTz, instantFromSqliteUtc, zoneOffsetLabel } from '../lib/tz.js';
import StatusForm from '../components/StatusForm.astro';
import { linkify } from '../lib/linkify.js';

export const prerender = false;

const TYPE_NAMES = { intro: 'Intro Call', career: 'Career Review', work: 'Working Session' };

// Display columns, left to right. `sortable` ones come from the whitelist in lib/requests.js.
const COLUMNS = [
  { key: 'slot_date', label: 'When', sortable: true },
  { key: 'name', label: 'Name', sortable: true },
  { key: 'email', label: 'Email', sortable: true },
  { key: 'type', label: 'Type', sortable: true },
  { key: 'status', label: 'Status', sortable: true },
  { key: 'note', label: 'Body', sortable: false, wide: true },
  { key: 'created_at', label: 'Requested', sortable: true }
];
const SORT_LINKS = COLUMNS.filter((c) => c.sortable);

const db = env?.DB;
const params = Astro.url.searchParams;

let rows = [];
let total = 0;
let pending = 0;
let list = listParams(params, 0);

if (db) {
  const totals = await db
    .prepare(
      "SELECT COUNT(*) AS total, COALESCE(SUM(CASE WHEN status = 'new' THEN 1 ELSE 0 END), 0) AS pending FROM requests"
    )
    .first();
  total = Number(totals?.total ?? 0);
  pending = Number(totals?.pending ?? 0);

  list = listParams(params, total);
  const { results } = await db
    .prepare(listSql(list.sort, list.dir))
    .bind(list.pageSize, list.offset)
    .all();
  // created_at is a UTC instant; the slot columns are already Minsk wall clock. Show both
  // in the zone the site runs on, so a row can be read without converting in your head.
  rows = (results || []).map((r) => ({
    ...r,
    requested: wallClockInTz(instantFromSqliteUtc(r.created_at), availability.timezone)
  }));
}

// Derived, not hardcoded: follows Europe/Minsk if its rules ever change.
const tzLabel = `${availability.timezone} (${zoneOffsetLabel(availability.timezone)})`;

const typeName = (id) => TYPE_NAMES[id] || id;
// Table-only short labels, so the Type column stays narrow; the full name is in the title.
const SHORT_TYPES = { intro: 'Intro', career: 'Career', work: 'Working' };
const typeShort = (id) => SHORT_TYPES[id] || id;
const isPast = (d) => d < new Date().toISOString().slice(0, 10);

// Clicking the active column flips direction; a new column starts ascending. Either way
// we go back to page 1, otherwise the page can land past the end of the new order.
const sortHref = (col) =>
  listHref(list, { sort: col, dir: list.sort === col && list.dir === 'asc' ? 'desc' : 'asc', page: 1 });
const ariaSort = (col) =>
  list.sort === col ? (list.dir === 'asc' ? 'ascending' : 'descending') : 'none';
const mark = (col) => (list.sort === col ? (list.dir === 'asc' ? '↑' : '↓') : '');
const statusTone = (s) =>
  s === 'declined' ? 'text-muted line-through' : s === 'new' ? 'text-brand' : 'text-foreground';
---

<Base title="Requests — Aliaksei Kozel" description="1:1 requests.">
  <section class="hair-b">
    <div class="px-[var(--pad)] pt-14 pb-6">
      <p class="mono text-brand">Me</p>
      <h1 class="page-title mt-4">1:1 / Requests</h1>
      <p class="mono mt-3 text-muted">{pending} to review · {total} total</p>
      <p class="mono mt-2 text-muted">Times in {tzLabel}</p>
    </div>

    <div class="px-[var(--pad)] pb-16">
      {total === 0 && <p class="text-muted">Nothing yet.</p>}

      {
        total > 0 && (
          <>
            {/* narrow screens: same rows as cards, with a sort row standing in for the table header */}
            <div class="mono mb-5 flex flex-wrap gap-x-3 gap-y-2 lg:hidden">
              {SORT_LINKS.map((c) => (
                <a
                  class:list={[
                    // The arrow is out of flow, in the gap: in flow it would change this link's
                    // width as the sort moves, and a wrapping row would re-wrap under your thumb.
                    'relative',
                    list.sort === c.key ? 'text-brand' : 'text-muted hover:text-brand'
                  ]}
                  href={`${sortHref(c.key)}#list`}
                >
                  {c.label}
                  <span class="absolute -right-3 text-brand">{mark(c.key)}</span>
                </a>
              ))}
            </div>

            <div id="list" class="grid gap-4 lg:hidden">
              {rows.map((r) => (
                <article class="hair grid gap-4 p-5">
                  <div class="grid gap-1">
                    <p class="mono text-muted">
                      <span class={r.status === 'declined' ? 'line-through' : ''}>
                        {r.slot_date} · {r.slot_time}
                      </span>
                      {' · '}
                      {typeName(r.type)}
                      {isPast(r.slot_date) && ' · past'}
                    </p>
                    <p class="text-lg font-medium">{r.name}</p>
                    <p class="text-sm">
                      <a class="text-secondary hover:text-brand" href={`mailto:${r.email}`}>
                        {r.email}
                      </a>
                    </p>
                    <p class={`mono mt-1 ${statusTone(r.status)}`}>{r.status}</p>
                    {r.note && <p class="mt-1 text-sm text-secondary" set:html={linkify(r.note)} />}
                  </div>
                  <StatusForm request={r} sort={list.sort} dir={list.dir} page={list.page} />
                </article>
              ))}
            </div>

            {/* md and up: the table proper */}
            <div class="hidden lg:block overflow-x-auto">
              <table class="req-table w-full border-collapse text-left">
                <thead>
                  <tr class="hair-b">
                    {COLUMNS.map((c) => (
                      <th
                        scope="col"
                        aria-sort={c.sortable ? ariaSort(c.key) : undefined}
                        class={`mono py-3 pr-4 font-normal text-muted ${c.wide ? 'w-full' : ''}`}
                      >
                        {c.sortable ? (
                          <a class="whitespace-nowrap hover:text-brand" href={sortHref(c.key)}>
                            {c.label}
                            <span class="ml-1.5 text-brand">{mark(c.key)}</span>
                          </a>
                        ) : (
                          c.label
                        )}
                      </th>
                    ))}
                    <th scope="col" class="mono py-3 text-right font-normal text-muted">
                      Actions
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr class="hair-b">
                      <td class="py-4 pr-4 text-sm leading-tight whitespace-nowrap">
                        <span class={r.status === 'declined' ? 'text-muted line-through' : ''}>
                          {r.slot_date}
                        </span>
                        {isPast(r.slot_date) && <span class="ml-2 text-muted">past</span>}
                        <span class="block text-muted">{r.slot_time}</span>
                      </td>
                      <td class="py-4 pr-4 whitespace-nowrap text-sm text-secondary">{r.name}</td>
                      <td class="py-4 pr-4 whitespace-nowrap text-sm">
                        <a class="text-secondary hover:text-brand" href={`mailto:${r.email}`}>
                          {r.email}
                        </a>
                      </td>
                      <td class="py-4 pr-4 whitespace-nowrap text-sm text-secondary">
                        <span title={typeName(r.type)}>{typeShort(r.type)}</span>
                      </td>
                      <td class="py-4 pr-4">
                        <span class="sr-only">{r.status}</span>
                        <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">
                          {r.status === 'confirmed' && (
                            <svg class="text-brand" width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
                              <path d="M4 10.5l4 4 8-9.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          )}
                          {r.status === 'declined' && (
                            <svg class="text-muted" width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
                              <path d="M5.5 5.5l9 9M14.5 5.5l-9 9" stroke-linecap="round" />
                            </svg>
                          )}
                          {r.status === 'new' && <span class="h-2 w-2 rounded-full bg-brand" />}
                        </span>
                      </td>
                      <td class="w-full py-4 pr-4 text-sm text-secondary">
                        {r.note ? (
                          <>
                            <span
                              class="line-clamp-2 cursor-pointer"
                              data-note
                              title="Show the whole note"
                              set:html={linkify(r.note)}
                            />
                            <button type="button" class="sr-only" data-note-toggle hidden>
                              Show the whole note
                            </button>
                          </>
                        ) : (
                          <span class="text-muted">—</span>
                        )}
                      </td>
                      <td class="py-4 pr-4 text-sm leading-tight whitespace-nowrap text-muted">
                        {r.requested.date}
                        <span class="block">{r.requested.time}</span>
                      </td>
                      <td class="py-4 whitespace-nowrap">
                        <StatusForm
                          request={r}
                          sort={list.sort}
                          dir={list.dir}
                          page={list.page}
                          variant="icon"
                        />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* pagination */}
            <div class="hair-t mt-6 flex items-center justify-between gap-4 pt-4">
              <p class="mono text-muted">Page {list.page} of {list.pages}</p>
              <div class="flex items-center gap-2">
                {list.page > 1 ? (
                  <a class="icon-btn p-1.5" href={listHref(list, { page: list.page - 1 })} aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                  </a>
                ) : (
                  <span class="icon-btn pointer-events-none p-1.5 opacity-30" aria-disabled="true" aria-label="Previous page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                  </span>
                )}
{list.page < list.pages ? (
                  <a class="icon-btn p-1.5" href={listHref(list, { page: list.page + 1 })} aria-label="Next page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M9 6l6 6-6 6"></path>
                    </svg>
                  </a>
                ) : (
                  <span class="icon-btn pointer-events-none p-1.5 opacity-30" aria-disabled="true" aria-label="Next page">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M9 6l6 6-6 6"></path>
                    </svg>
                  </span>
                )}
              </div>
            </div>
          </>
        )
      }
    </div>
  </section>
  <script>
    import '../assets/js/notes.js';
  </script>
</Base>
