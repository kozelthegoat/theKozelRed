---
import Base from '../../../layouts/Base.astro';
import { env } from 'cloudflare:workers';
import { listHref, parsePage, parsePast, parseSort, statusLabel } from '../../../lib/requests.js';
import { availability, sessionTypes } from '../../../data/sessions.js';
import {
  wallClockInTz,
  instantFromSqliteUtc,
  zonedWallClockToUtc,
  isValidZone,
  zoneOffsetLabel
} from '../../../lib/tz.js';
import { labelFor } from '../../../i18n/config.mjs';
import { linkify } from '../../../lib/linkify.js';
import StatusForm from '../../../components/StatusForm.astro';
import DeleteForm from '../../../components/DeleteForm.astro';

export const prerender = false;

// The list no longer carries the actions: this page is where a request is decided, so a
// mis-click cannot send an email from a dense row.
const id = Number(Astro.params.id);
const { sort, dir } = parseSort(Astro.url.searchParams);
const page = parsePage(Astro.url.searchParams);
const past = parsePast(Astro.url.searchParams);
const back = listHref({ sort, dir, page, past });

const db = env?.DB;
let row = null;
if (db && Number.isInteger(id)) {
  row = await db
    .prepare(
      'SELECT id, type, slot_date, slot_time, name, email, note, status, created_at, visitor_tz, locale FROM requests WHERE id = ?'
    )
    .bind(id)
    .first();
}
if (!row) Astro.response.status = 404;

const type = row ? sessionTypes.find((t) => t.id === row.type) : null;
const typeName = type?.name ?? row?.type ?? '';
const tzLabel = `${availability.timezone} (${zoneOffsetLabel(availability.timezone)})`;
const requested = row ? wallClockInTz(instantFromSqliteUtc(row.created_at), availability.timezone) : null;
const theirZone =
  row?.visitor_tz && isValidZone(row.visitor_tz)
    ? `${row.visitor_tz} (${zoneOffsetLabel(row.visitor_tz)})`
    : null;
const theirClock = theirZone
  ? wallClockInTz(
      zonedWallClockToUtc(row.slot_date, row.slot_time, availability.timezone),
      row.visitor_tz
    )
  : null;
const language = row?.locale ? labelFor(row.locale) : null;
---

<Base
  title={row ? `${row.name} — 1:1 request` : 'Aliaksei Kozel — Request'}
  description="1:1 request."
>
  <section>
    <div class="px-[var(--pad)] pt-14 pb-8">
      <a class="mono text-muted hover:text-brand" href={back}>← All requests</a>
      <p class="mono mt-8 text-brand">Me</p>
      {row ? (
        <>
          <h1 class="page-title mt-4">{row.name}</h1>
        </>
      ) : (
        <>
          <h1 class="page-title mt-4">No such request</h1>
          <p class="mt-3 text-secondary">It may have been deleted, or it never existed.</p>
        </>
      )}
    </div>
  </section>

  {
    row && (
      <section>
        <div class="grid gap-10 px-[var(--pad)] pb-16 md:grid-cols-[1.6fr_1fr]">
          <div class="grid content-start gap-8">
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <p class="mono text-muted">Status</p>
                <p class="mt-2 text-secondary">{statusLabel(row.status)}</p>
              </div>
              <div>
                <p class="mono text-muted">When</p>
                <p class="mt-2 text-secondary">{row.slot_date} · {row.slot_time}</p>
                <p class="mono mt-1 text-muted">{tzLabel}</p>
              </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <p class="mono text-muted">Requested</p>
                <p class="mt-2 text-secondary">{requested.date} · {requested.time}</p>
              </div>
              <div>
                <p class="mono text-muted">Their clock</p>
                <p class="mt-2 text-secondary">
                  {theirClock ? `${theirClock.date} · ${theirClock.time}` : 'Unknown'}
                </p>
                {theirZone && <p class="mono mt-1 text-muted">{theirZone}</p>}
              </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <p class="mono text-muted">Session</p>
                <p class="mt-2 text-secondary">
                  {typeName}
                  {type ? ` · ${type.minutes} min` : ''}
                </p>
              </div>
              <div>
                <p class="mono text-muted">Language</p>
                <p class="mt-2 text-secondary">{language ?? 'English'}</p>
              </div>
            </div>

            <div>
              <p class="mono text-muted">Message</p>
              {row.note ? (
                <p class="mt-3 max-w-[62ch] text-secondary" set:html={linkify(row.note)} />
              ) : (
                <p class="mt-3 text-muted">No message.</p>
              )}
            </div>

            <div>
              <p class="mono text-muted">Contact</p>
              <p class="mt-3">
                <a class="text-secondary hover:text-brand" href={`mailto:${row.email}`}>
                  {row.email}
                </a>
              </p>
            </div>
          </div>

          <aside class="grid content-start gap-6 self-start">
            <p class="mono text-muted">Actions</p>
            <StatusForm
              request={row}
              sort={sort}
              dir={dir}
              page={page}
              past={past}
              variant="inline"
            />
            <div class="mt-4">
              <DeleteForm request={row} sort={sort} dir={dir} page={page} past={past} />
            </div>
          </aside>
        </div>
      </section>
    )
  }

  <script>
    import '../../../assets/js/requests.js';
  </script>
</Base>
