---
import NotePost from '../../components/pages/NotePost.astro';
import { publishedNotes, allNotes } from '../../lib/note-source.js';
import { slugOfId, localesForSlug } from '../../lib/notes.js';

export async function getStaticPaths() {
  const [notes, all] = await Promise.all([publishedNotes('en'), allNotes()]);
  return notes.map((note) => {
    const slug = slugOfId(note.id);
    // Only the languages this piece actually exists in, so the switcher cannot offer a 404.
    return { params: { slug }, props: { note, alternates: localesForSlug(all, slug) } };
  });
}

const { note, alternates } = Astro.props;
---

<NotePost locale="en" note={note} alternates={alternates} />
