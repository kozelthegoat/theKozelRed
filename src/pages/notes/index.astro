---
import Base from '../../layouts/Base.astro';
import { publishedNotes } from '../../lib/note-source.js';
import { formatNoteDate } from '../../lib/notes.js';

const notes = await publishedNotes();
---

<Base
  title="Aliaksei Kozel — Notes"
  description="Notes and older thoughts, kept as they were written."
>
  <section class="hair-b">
    <div class="px-[var(--pad)] pt-14 pb-12">
      <p class="mono text-brand">Notes</p>
      <h1 class="page-title mt-4">Notes</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        Older thoughts, kept as they were written — dated by when I had them, not by when they
        went up.
      </p>
    </div>
  </section>

  <section>
    <div class="px-[var(--pad)] py-4 pb-20">
      {
        notes.length === 0 ? (
          <p class="py-10 text-muted">Nothing published yet.</p>
        ) : (
          <ul>
            {notes.map((note) => (
              <li class="hair-b">
                <a
                  class="group grid gap-3 py-9 md:grid-cols-[9rem_1fr] md:gap-10"
                  href={`/notes/${note.id}/`}
                >
                  <span class="mono text-muted">{formatNoteDate(note.data.date)}</span>
                  <span class="grid gap-2">
                    <span class="text-[clamp(1.25rem,2.4vw,1.8rem)] font-medium transition-colors group-hover:text-brand">
                      {note.data.title}
                    </span>
                    <span class="max-w-[62ch] text-secondary">{note.data.summary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
