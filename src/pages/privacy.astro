---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy — Aliaksei Kozel" description="What this site stores, and what it doesn’t.">
  <section class="hair-b hair-soft">
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">Privacy</p>
      <h1 class="mt-5 text-[clamp(2rem,5vw,3.5rem)] font-medium">Privacy</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        I keep only what I need to reply to you, and nothing here tracks you.
      </p>
    </div>
  </section>

  <section class="hair-b hair-soft">
    <div class="grid max-w-[70ch] gap-8 px-[var(--pad)] py-14">
      <div>
        <p class="mono text-muted">What I collect</p>
        <p class="mt-3 text-secondary">Your name. Your email address. Your notes (if any).</p>
        <p class="text-secondary">(when you schedule the 1:1 session)</p>
      </div>
      <div>
        <p class="mono text-muted">Why</p>
        <p class="mt-3 text-secondary">To arrange, confirm, and prepare for the 1:1 session.</p>
      </div>
      <div>
        <p class="mono text-muted">Where it goes</p>
        <ul class="mt-3 grid gap-1 text-secondary">
          <li class="flex gap-3">
            <span class="text-brand">—</span>
            <span><span class="text-foreground">Cloudflare</span>: hosts this site and stores your request.</span>
          </li>
          <li class="flex gap-3">
            <span class="text-brand">—</span>
            <span><span class="text-foreground">Resend</span>: delivers the emails.</span>
          </li>
        </ul>
      </div>
      <div>
        <p class="mono text-muted">Cookies &amp; tracking</p>
        <p class="mt-3 text-secondary">No cookies. No analytics. No ads.</p>
        <p class="mt-3 text-secondary">
          The only thing kept on your device is two small preferences — your timezone and your calendar layout — in local storage, so the booking page remembers them. They never leave your browser and are not sent anywhere.
        </p>
      </div>
    </div>
  </section>
</Base>
