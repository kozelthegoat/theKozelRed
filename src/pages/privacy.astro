---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
---
<Base title="Privacy — Aliaksei Kozel" description="What this site stores, and what it doesn’t.">
  <section class="hair-b hair-soft">
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">Privacy</p>
      <h1 class="mt-5 text-[clamp(2rem,5vw,3.5rem)] font-medium">Privacy</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        The short version: I keep only what I need to reply to you, and nothing here tracks you.
      </p>
    </div>
  </section>

  <section class="hair-b hair-soft">
    <div class="grid max-w-[70ch] gap-8 px-[var(--pad)] py-14">
      <div>
        <p class="mono text-muted">What I collect</p>
        <p class="mt-3 text-secondary">
          When you request a 1:1: your <strong class="text-foreground">name</strong>, your
          <strong class="text-foreground">email</strong>, and anything you add in the note. That’s all.
        </p>
      </div>
      <div>
        <p class="mono text-muted">Why</p>
        <p class="mt-3 text-secondary">Only to arrange, confirm, and prepare for that session.</p>
      </div>
      <div>
        <p class="mono text-muted">Where it goes</p>
        <p class="mt-3 text-secondary">
          Stored on Cloudflare and emailed through Resend, our email provider. No one else sees it.
        </p>
      </div>
      <div>
        <p class="mono text-muted">Cookies &amp; tracking</p>
        <p class="mt-3 text-secondary">
          None. No cookies, no analytics, no ads. The fonts are served from this site, so there are no
          third-party requests.
        </p>
      </div>
      <div>
        <p class="mono text-muted">Removing it</p>
        <p class="mt-3 text-secondary">
          Want your details deleted? Write to
          <a class="underline underline-offset-4 transition-colors hover:text-brand" href={`mailto:${site.email}`}
            >{site.email}</a
          >, and I’ll remove them.
        </p>
      </div>
    </div>
  </section>
</Base>
