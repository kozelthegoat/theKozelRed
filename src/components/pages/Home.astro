---
import Cta from '../../components/Cta.astro';
import Recommendation from '../../components/Recommendation.astro';
import { site, locationFor, availabilityFor, languagesFor, offClockFor } from '../../data/site.js';
import { sessionTypesFor } from '../../data/sessions.js';
import {
  recommendationsFor,
  homeRecommendations,
  recommenderUrls,
  orgUrls,
  earlierOrgUrls,
  helpWithFor,
  experienceFor,
  earlierRolesFor
} from '../../data/resume.js';
import { localeFromPath } from '../../i18n/config.mjs';
import { translator } from '../../i18n/ui.mjs';

// Reads the language from the path itself, exactly as Base does, so one component serves all three
// routes. The CV prose comes per language; company names, people and game titles do not.
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const sessionTypes = sessionTypesFor(locale);
const helpWith = helpWithFor(locale);
const experience = experienceFor(locale);
const earlierRoles = earlierRolesFor(locale);
const originalLabel = t('reco.seeOriginal');
const translationLabel = t('reco.seeTranslation');
// The three roles are one list; the promise is its own, smaller line. Stored as two strings so a
// translator chooses the words, not the separator the layout depends on.
const roles = t('home.roles').split(' · ');
const clause = t('home.clause');
const location = locationFor(locale);
const availability = availabilityFor(locale);
const languages = languagesFor(locale);
const offClock = offClockFor(locale);

// Two here, the rest at /recommendations/. Order follows the source array, so Mike comes first —
// the employer-side sentence is the one worth reading before the others.
const featured = recommendationsFor(locale).filter((r) => homeRecommendations.includes(r.author));
---

  <!-- hero -->
  <section>
    <div class="grid lg:grid-cols-[1fr_auto]">
      <div class="px-[var(--pad)] pt-20 pb-14">
        <p class="mono text-brand">{t('home.eyebrow')}</p>
        <h1 class="mt-6 max-w-[18ch] text-[clamp(2rem,6.7vw,5rem)] font-medium">
          {
            roles.map((role) => (
              <span class="block whitespace-nowrap">
                <span aria-hidden="true">· </span>
                {role}
              </span>
            ))
          }
          <span class="mt-3 block text-[max(1rem,0.42em)] leading-[1.15] tracking-normal text-muted">
            <span aria-hidden="true">— </span>
            {clause}
          </span>
        </h1>
        <div class="mt-12 flex flex-wrap gap-3">
          <Cta href={site.resume} label={t('cta.resume')} arrow={false} download />
        </div>
        <p class="mono mt-10 max-w-[54rem] text-balance">
          <span class="text-brand">{t('home.motto')}</span>
        </p>
      </div>
      <div class="px-[var(--pad)] pb-14 pt-10 lg:w-[22rem] lg:pt-20">
        <dl class="mono grid gap-x-10 gap-y-6 text-muted md:grid-cols-2 lg:grid-cols-1">
          <div><dt>{t('footer.location')}</dt><dd class="mt-2 whitespace-pre-line text-foreground">{location}</dd></div>
          <div>
            <dt>{t('footer.availability')}</dt>
            <dd class="mt-2 text-foreground">
              <ul class="grid gap-1">
                {availability.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
          <div>
            <dt>{t('fact.languages')}</dt>
            <dd class="mt-2 text-foreground">
              <ul class="grid gap-1">
                {languages.map((lang) => (
                  <li>{lang}</li>
                ))}
              </ul>
            </dd>
          </div>
          <div>
            <dt>{t('fact.offClock')}</dt>
            <dd class="mt-2 text-foreground">
              <ul class="grid gap-1">
                {offClock.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        </dl>
      </div>
    </div>
    <div>
      <picture>
        <source
          type="image/webp"
          srcset="/kozel-photo-3-1280.webp 1280w, /kozel-photo-3.webp 1920w"
          sizes="100vw"
        />
        <img
          src="/kozel-photo-3-1280.jpg"
          srcset="/kozel-photo-3-1280.jpg 1280w, /kozel-photo-3.jpg 1920w"
          sizes="100vw"
          width="1920"
          height="1080"
          alt="Aliaksei Kozel"
          class="block h-auto w-full"
        />
      </picture>
    </div>
  </section>

  <!-- what I can help -->
  <section id="expertise">
    <div class="px-[var(--pad)] pt-14">
      <p class="mono text-brand">{t('nav.expertise')}</p>
      <h2 class="mt-4 max-w-[26ch] text-[clamp(1.55rem,4vw,2.6rem)] font-medium">
        {t('home.expertise.title')}
      </h2>
    </div>
    <ul class="grid gap-x-12 gap-y-6 px-[var(--pad)] pt-8 pb-16 md:grid-cols-2">
      {
        helpWith.map((item, i) => (
          <li
            class="reveal group grid grid-cols-[2.5rem_1fr] items-baseline gap-3"
            style={`transition-delay: ${i * 45}ms`}
          >
            <span class="mono text-muted transition-colors group-hover:text-brand">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span
              class="inline-block text-[clamp(1.05rem,1.9vw,1.4rem)] font-medium uppercase leading-[1.15] tracking-tight text-foreground transition-all duration-500 group-hover:translate-x-1 group-hover:text-brand"
            >
              {item}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- experience -->
  <section id="experience">
    <div class="px-[var(--pad)] pt-12">
      <p class="mono text-brand">{t('nav.experience')}</p>
      <h2 class="mt-4 text-[clamp(1.55rem,4vw,2.8rem)] font-medium">{t('home.experience.title')}</h2>
    </div>
    {
      experience.map((job, i) => (
        <article class="grid gap-6 px-[var(--pad)] py-10 md:grid-cols-[1fr_2fr]">
          <div>
            <h3 class="text-2xl font-medium tracking-tight">{job.role}</h3>
            <p class="mono mt-3 text-muted">
              {
                orgUrls[job.org] ? (
                  <a
                    class="transition-colors hover:text-brand"
                    href={orgUrls[job.org]}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {job.org}
                  </a>
                ) : (
                  job.org
                )
              }
            </p>
            <div class="mono mt-1 grid gap-0.5 text-muted">
              <span>{job.where}</span>
              <span>{job.when}</span>
            </div>
          </div>
          <div>
            {job.intro && <p class="mb-4 text-[0.98rem] text-foreground">{job.intro}</p>}
            <ul class="grid gap-2 text-[0.98rem] text-secondary">
              {job.points.map((point) => (
                <li class="flex gap-3">
                  <span class="text-brand">–</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            {
              job.released && (
                <div class="mt-5">
                  <p class="mono text-muted">{t('home.released')}</p>
                  <ul class="mt-2 grid gap-2 text-[0.92rem] text-secondary">
                    {job.released.map((item) => {
                      const title = typeof item === 'string' ? item : item.title;
                      const notes = typeof item === 'string' ? [] : item.notes || [];
                      return (
                        <li class="flex flex-col gap-1">
                          <span class="flex gap-3">
                            <svg
                              class="mt-[0.2rem] h-3.5 w-3.5 shrink-0 text-brand"
                              viewBox="0 0 20 20"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.5"
                              aria-hidden="true"
                            >
                              <path d="M4 10.5l4 4 8-9.5" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            <span>{title}</span>
                          </span>
                          {notes.length > 0 && (
                            <ul class="ml-6 grid gap-1 text-muted">
                              {notes.map((note) => (
                                <li class="flex gap-2">
                                  <span class="text-brand">–</span>
                                  <span>{note}</span>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              )
            }
          </div>
        </article>
      ))
    }
    <div class="px-[var(--pad)] py-8">
      <ul class="mono grid gap-2 text-muted">
        {earlierRoles.map((r) => (
          <li>
            {r.role},{' '}
            {
              earlierOrgUrls[r.org] ? (
                <a
                  class="transition-colors hover:text-brand"
                  href={earlierOrgUrls[r.org]}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {r.org}
                </a>
              ) : (
                r.org
              )
            }{' '}
            <span class="mt-0.5 block text-secondary leading-[1.5] sm:mt-0 sm:inline sm:leading-none">({r.when})</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- recommendations -->
  <section id="recommendations">
    <div class="px-[var(--pad)] pt-18">
      <p class="mono text-brand">{t('reco.eyebrow')}</p>
      <h2 class="mt-4 text-[clamp(1.55rem,4vw,2.8rem)] font-medium">{t('home.recommendations.title')}</h2>
    </div>
    <div class="grid md:grid-cols-2">
      {
        featured.map((r, i) => (
          <Recommendation
            quote={r.quote}
            original={r.original}
            originalLabel={originalLabel}
            translationLabel={translationLabel}
            author={r.author}
            url={recommenderUrls[r.author]}
            index={i}
            variant="grid"
          />
        ))
      }
    </div>
    <div class="px-[var(--pad)] py-10">
      <Cta href="/recommendations/" label={t('footer.recommendations')} />
    </div>
  </section>

  <!-- resume CTA -->
  <!-- pro bono / 1:1 -->
  <section id="pro-bono" class="grid gap-8 px-[var(--pad)] pt-18 pb-16 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="mono text-brand">{t('footer.proBono')}</p>
      <h2 class="mt-4 max-w-[26ch] text-[clamp(1.55rem,4vw,2.6rem)] font-medium">
        {t('home.proBono.title')}
      </h2>
      <!-- What pro bono means here: not a discount on a service, but time given. -->
      <p class="mt-4 max-w-[46ch] text-secondary">
        {t('home.proBono.sub')}
      </p>
    </div>
    <!-- What the three sessions are, not a way to choose one: choosing happens on the schedule,
         where the calendar and the form are. This is the invitation, and the button is the door —
         which comes after them on every size, rather than between the invitation and what it offers. -->
    <div class="grid gap-5 md:col-span-2 md:grid-cols-3">
      {
        sessionTypes.map((session) => (
          <div class="hair grid content-start gap-3 p-5">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="text-lg font-medium">{session.audience}</h3>
              <span class="mono text-muted">{session.minutes} min</span>
            </div>
            <p class="text-sm text-secondary">{session.description}</p>
          </div>
        ))
      }
    </div>
    <div class="md:col-span-2">
      <Cta href="/schedule/" label={t('cta.schedule')} />
    </div>
  </section>

  <script>
    import '../../assets/js/recommendations.js';
  </script>
