---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { formatNoteDate } from '../../lib/notes.js';
import { prefixFor } from '../../i18n/config.mjs';
import { translator } from '../../i18n/ui.mjs';

const { locale, note, alternates } = Astro.props;
const t = translator(locale);
const { Content } = await render(note);
const base = prefixFor(locale);
---

<Base
  title={`Aliaksei Kozel — ${note.data.title}`}
  description={note.data.summary}
  alternates={alternates}
  lang={locale}
>
  <article>
    <div class="px-[var(--pad)] pt-14 pb-10">
      <p class="mono text-muted">{formatNoteDate(note.data.date, locale)}</p>
      <h1 class="mt-5 max-w-[26ch] text-[clamp(1.65rem,6vw,3.5rem)] font-medium">{note.data.title}</h1>
      <p class="mt-6 max-w-[56ch] text-lg text-secondary">{note.data.summary}</p>
    </div>
    <div class="px-[var(--pad)] pb-16">
      <div class="prose">
        <Content />
      </div>
      <p class="mono mt-16">
        <a class="text-muted hover:text-brand" href={`${base}/notes/`}>{t('notes.back')}</a>
      </p>
    </div>
  </article>
</Base>
