---
import Base from '../../layouts/Base.astro';
import { sessionTypes, availability } from '../../data/sessions.js';
import { site } from '../../data/site.js';
---

  <section class="hair-b">
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">Pro Bono</p>
      <h1 class="page-title mt-4 max-w-[20ch]">1:1 / Schedule</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        Pick a session type, a date, a time, and a bit of context to share.<br />
        I’ll see what’s on my plate, and come back to you either way.
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
          {
            ['Free', 'Volunteering', 'No strings'].map((tag) => (
            <li class="tag mono px-3 py-1.5">{tag}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="px-[var(--pad)] pt-14">
      <p class="mono text-brand">Sessions</p>
      <h2 class="mt-4 max-w-[24ch] text-[clamp(1.8rem,4vw,3rem)] font-medium">What you bring, what you leave with</h2>
    </div>
    <!--
      Descriptions, not a control. Three ways to use the time, each saying what it asks of you and
      what you leave with. The choice itself is one line down in the details, where the booking is
      made — so the thing you read and the thing you press are in the place each belongs.
    -->
    <div class="grid gap-5 px-[var(--pad)] pt-8 pb-16 md:grid-cols-3 md:gap-y-5">
      {
        sessionTypes.map((t) => (
          <div class="grid content-start gap-5 md:row-span-4 md:grid-rows-subgrid">
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-xl font-medium uppercase">{t.audience}</span>
              <span class="mono text-muted">{t.minutes} min</span>
            </div>
            <p class="text-secondary">{t.description}</p>
            <div>
              <p class="mono text-muted">You bring</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {t.bring.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">–</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="mono text-muted">You leave with</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {t.build.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">–</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="hair-b">
    <!-- The calendar, and beside it the details, where the session and the rest are chosen. -->
    <p class="mono px-[var(--pad)] pt-14 text-brand">Calendar</p>
    <div class="grid gap-10 px-[var(--pad)] py-14 md:grid-cols-[1.6fr_1fr]" data-schedule>
      <div>
        <div data-step="slots">
          <div class="flex items-center justify-between gap-4">
            <p class="mono text-muted" data-month-label></p>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-0.5" data-month-nav>
                <button type="button" class="icon-btn p-1.5" data-month-prev aria-label="Previous month">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6"></path>
                  </svg>
                </button>
                <button type="button" class="icon-btn p-1.5" data-month-next aria-label="Next month">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M9 6l6 6-6 6"></path>
                  </svg>
                </button>
              </div>
              <div class="flex gap-0.5" data-layout-switch role="group" aria-label="Layout">
                <button type="button" class="seg-btn p-1.5" data-layout="month" aria-pressed="true" aria-label="Month view" title="Month">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                    <path d="M3 9h18M8 2v4M16 2v4"></path>
                  </svg>
                </button>
                <button type="button" class="seg-btn p-1.5" data-layout="week" aria-pressed="false" aria-label="Week view" title="Week">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                    <path d="M3 9h18M9 9v12M15 9v12"></path>
                  </svg>
                </button>
                <button type="button" class="seg-btn p-1.5" data-layout="list" aria-pressed="false" aria-label="List view" title="List">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="mono text-muted">Times in</span>
            <div class="relative" data-tz-picker>
              <button
                type="button"
                class="hair flex w-64 items-center justify-between gap-2 bg-transparent py-1.5 pr-2 pl-3 text-sm"
                data-tz-trigger
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span class="min-w-0 flex-1 truncate text-left" data-tz-label></span>
                <span class="shrink-0 text-muted" data-tz-offset></span>
                <svg class="shrink-0 text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </button>
              <div class="hair absolute z-20 mt-1 hidden w-64 bg-background" data-tz-panel>
                <div class="sticky top-0 bg-background p-2">
                  <input
                    type="text"
                    class="field w-full px-3 py-1.5 text-sm"
                    placeholder="Search a city…"
                    data-tz-search
                    aria-label="Search timezones"
                  />
                </div>
                <ul class="max-h-64 overflow-auto" data-tz-options role="listbox" aria-label="Timezones"></ul>
              </div>
            </div>
          </div>

          <div class="mt-4" data-view="month">
            <div class="grid grid-cols-7 gap-1 text-center">
              {
                ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => (
                  <span class="mono py-2 text-muted">{d}</span>
                ))
              }
            </div>
            <div class="grid grid-cols-7 gap-1 text-center" data-days></div>
            <div class="mt-6" data-times-wrap hidden>
              <p class="mono text-muted" data-times-label></p>
              <div class="mt-3 flex flex-wrap gap-2" data-times></div>
            </div>
          </div>

          <div class="mt-4 hidden" data-view="list">
            <div class="grid gap-6" data-list></div>
          </div>
        </div>

      </div>

      <div>
        <form id="request" data-step="form" class="grid gap-4" novalidate>
          <!--
            One line each, chosen here where the booking is made. The descriptions above say what
            each one involves; this says which one you're asking for, as the last thing before your
            details. Radios, so the browser carries the choice and the keyboard carries it too.
          -->
          <div class="grid gap-2" data-schedule-types>
            <p class="mono text-muted">Session</p>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              {
                sessionTypes.map((t, i) => (
                  <label class="flex cursor-pointer items-center gap-2 text-sm">
                    <input
                      type="radio"
                      name="session-type"
                      value={t.id}
                      data-type={t.id}
                      class="radio-dot"
                      checked={i === 0}
                    />
                    <span>{t.audience}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <p class="mono text-muted">Details</p>
          <div class="relative">
            <input
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Name"
              class="field w-full px-4 py-3"
              style="padding-inline-end: 2.25rem"
            />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-brand" aria-hidden="true">*</span>
          </div>
          <div class="relative">
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="Email"
              class="field w-full px-4 py-3"
              style="padding-inline-end: 2.25rem"
            />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-brand" aria-hidden="true">*</span>
          </div>
          <textarea
            name="note"
            rows="3"
            placeholder="What’s on your mind?"
            class="field w-full px-4 py-3"></textarea>
          <p class="text-sm text-brand" data-form-error hidden></p>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn mono">Send request</button>
          </div>
        </form>

        <dialog data-step="done" class="req-done" aria-labelledby="done-heading">
          <button
            type="button"
            class="icon-btn absolute right-3 top-3"
            data-done-close
            aria-label="Close"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <div class="grid gap-4">
            <p class="mono text-brand" id="done-heading">Requested</p>
            <p class="max-w-[46ch] text-lg">{site.confirmation.thanks}</p>
            <p class="max-w-[46ch] text-secondary" data-done-note></p>
            <p class="max-w-[46ch] text-secondary">
              {site.confirmation.next}{site.meetingUrl ? ' The link to join comes with it.' : ''}
            </p>
            <p class="mono text-muted" data-done-summary></p>
          </div>
        </dialog>
      </div>
    </div>
  </section>

  <script
    type="application/json"
    data-schedule-config
    set:html={JSON.stringify({
      types: sessionTypes.map((t) => ({
        id: t.id,
        audience: t.audience,
        minutes: t.minutes,
        confirmation: t.confirmation
      })),
      timezone: availability.timezone
    })}
  ></script>
  <script>
    import '../../assets/js/schedule.js';
  </script>
