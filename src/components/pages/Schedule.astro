---
import Base from '../../layouts/Base.astro';
import { sessionTypesFor, availability } from '../../data/sessions.js';
import { site } from '../../data/site.js';
import { intlTagFor, localeFromPath } from '../../i18n/config.mjs';
import { urlFor } from '../../i18n/pages.mjs';
import { translator } from '../../i18n/ui.mjs';

// Reads the language from the path, exactly as Base does, so one component serves all three routes.
// The session copy comes per language; the labels ("RE: Anything") do not, being names.
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const sessionTypes = sessionTypesFor(locale);
---

  <section>
    <div class="px-[var(--pad)] py-14">
      <p class="mono text-brand">{t('sched.eyebrow')}</p>
      <h1 class="page-title mt-4 max-w-[20ch]">{t('sched.title')}</h1>
      <p class="mt-6 max-w-[52ch] text-secondary">
        {t('sched.intro1')} {t('sched.intro2')}
      </p>
      <ul class="mt-5 flex flex-wrap gap-2">
          {
            [t('sched.tag.free'), t('sched.tag.volunteering'), t('sched.tag.nostrings')].map((tag) => (
            <li class="tag mono px-3 py-1.5">{tag}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section>
    <div class="px-[var(--pad)] pt-14">
      <p class="mono text-brand">{t('sched.sessions')}</p>
      <h2 class="mt-4 max-w-[24ch] text-[clamp(1.55rem,4vw,2.6rem)] font-medium">{t('sched.sessions.title')}</h2>
    </div>
    <!--
      Descriptions, not a control. Three ways to use the time, each saying what it asks of you and
      what we build. The choice itself is one line down in the details, where the booking is made —
      so the thing you read and the thing you press are in the place each belongs.

      The treatment the recommendations get: a rule between the cards that goes brand under the
      pointer, and a lift on hover. The padding sits on the card rather than the row, so the rule
      runs the full height of the grid instead of stopping short above and below it.
    -->
    <div class="grid md:grid-cols-3 md:gap-y-5">
      {
        sessionTypes.map((session, i) => (
          <div
            class:list={[
              'group relative grid content-start gap-5 p-[var(--pad)] transition-transform duration-300 ease-out hover:-translate-y-1 md:row-span-4 md:grid-rows-subgrid',
              i > 0 && 'hair-t-mobile',
              i > 0 && 'hair-l-md'
            ]}
          >
            <span class="pointer-events-none absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 bg-brand transition-transform duration-300 ease-out group-hover:scale-y-100"></span>
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-xl font-medium uppercase">{session.audience}</span>
              <span class="mono text-muted">{session.minutes} min</span>
            </div>
            <p class="text-secondary">{session.description}</p>
            <div>
              <p class="mono text-muted">{t('sched.youBring')}</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {session.bring.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">–</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="mono text-muted">{t('sched.weBuild')}</p>
              <ul class="mt-2 grid gap-1 text-secondary">
                {session.build.map((item) => (
                  <li class="flex gap-3">
                    <span class="text-brand">–</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <!-- The calendar, and beside it the details, where the session and the rest are chosen. -->
    <p class="mono px-[var(--pad)] pt-14 text-brand">{t('sched.calendar')}</p>
    <div class="grid gap-10 px-[var(--pad)] pt-8 pb-14 md:grid-cols-[1.6fr_1fr]" data-schedule>
      <div>
        <div data-step="slots">
          <!-- Shares .col-head with the Session label that opens the other column, so the two
               headings sit on one line and each is centred against its own controls. -->
          <div class="col-head justify-between gap-4">
            <p class="mono text-muted" data-month-label></p>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-0.5" data-month-nav>
                <button type="button" class="icon-btn p-1.5" data-month-prev aria-label={t('sched.prevMonth')}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6"></path>
                  </svg>
                </button>
                <button type="button" class="icon-btn p-1.5" data-month-next aria-label={t('sched.nextMonth')}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M9 6l6 6-6 6"></path>
                  </svg>
                </button>
              </div>
              <div class="flex gap-0.5" data-layout-switch role="group" aria-label={t('sched.layout')}>
                <button type="button" class="seg-btn p-1.5" data-layout="month" aria-pressed="true" aria-label={t('sched.view.month')} title={t('sched.view.month')}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                    <path d="M3 9h18M8 2v4M16 2v4"></path>
                  </svg>
                </button>
                <button type="button" class="seg-btn p-1.5" data-layout="four" aria-pressed="false" aria-label={t('sched.view.four')} title={t('sched.view.four')}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                  </svg>
                </button>
                <button type="button" class="seg-btn p-1.5" data-layout="list" aria-pressed="false" aria-label={t('sched.view.list')} title={t('sched.view.list')}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="mono text-muted">{t('sched.timesIn')}</span>
            <div class="relative" data-tz-picker>
              <button
                type="button"
                class="hair flex w-64 items-center justify-between gap-2 bg-transparent py-1.5 pr-2 pl-3 text-sm"
                data-tz-trigger
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span class="min-w-0 flex-1 truncate text-left" data-tz-label></span>
                <span class="shrink-0 text-muted" data-tz-offset></span>
                <svg class="shrink-0 text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"></path>
                </svg>
              </button>
              <div class="hair absolute z-20 mt-1 hidden w-64 bg-background" data-tz-panel>
                <div class="sticky top-0 bg-background p-2">
                  <input
                    type="text"
                    class="field w-full px-3 py-1.5 text-sm"
                    placeholder={t('sched.searchCity')}
                    data-tz-search
                    aria-label={t('sched.searchTimezones')}
                  />
                </div>
                <ul class="max-h-64 overflow-auto" data-tz-options role="listbox" aria-label={t('sched.timezones')}></ul>
              </div>
            </div>
          </div>

          <div class="mt-4" data-view="month">
            <div class="grid grid-cols-7 gap-1 text-center">
              {
                ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => (
                  <span class="mono py-2 text-muted">{d}</span>
                ))
              }
            </div>
            <div class="grid grid-cols-7 gap-1 text-center" data-days></div>
            <div class="mt-6" data-times-wrap hidden>
              <p class="mono text-muted" data-times-label></p>
              <div class="mt-3 flex flex-wrap gap-2" data-times></div>
            </div>
          </div>

          <div class="mt-4 hidden" data-view="list">
            <div class="grid gap-6" data-list></div>
          </div>
        </div>

      </div>

      <!--
        The column is stretched to the calendar's height and the form fills it, so the message field
        takes up whatever the calendar leaves. That is what keeps the two columns ending on one line:
        the calendar is four to six rows tall depending on the month, so a fixed height here would
        drift out of step by a row and no rule would catch it.
      -->
      <div class="flex flex-col">
        <form id="request" data-step="form" class="flex flex-1 flex-col gap-4" novalidate>
          <!-- A person never sees this; a naive form-filler completes every input it finds. It is
               off-screen rather than hidden with display:none, which most bots skip. -->
          <div class="trap" aria-hidden="true">
            <label>Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
          </div>
          <!--
            One line each, chosen here where the booking is made. The descriptions above say what
            each one involves; this says which one you're asking for, as the last thing before your
            details. Radios, so the browser carries the choice and the keyboard carries it too.
          -->
          <div class="grid gap-2" data-schedule-types>
            <div class="col-head"><p class="mono text-muted">{t('sched.session')}</p></div>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              {
        sessionTypes.map((session, i) => (
                  <label class="flex cursor-pointer items-center gap-2 text-sm">
                    <input
                      type="radio"
                      name="session-type"
                      value={session.id}
                      data-type={session.id}
                      class="control"
                      checked={i === 0}
                    />
                    <span>{session.audience}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <p class="mono text-muted">{t('sched.details')}</p>
          <div class="relative">
            <input
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder={t('sched.name')}
              class="field w-full px-4 py-3"
              style="padding-inline-end: 2.25rem"
            />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-brand" aria-hidden="true">*</span>
          </div>
          <div class="relative">
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={t('sched.email')}
              class="field w-full px-4 py-3"
              style="padding-inline-end: 2.25rem"
            />
            <span class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2 text-brand" aria-hidden="true">*</span>
          </div>
          <textarea
            name="note"
            rows="3"
            placeholder={t('sched.message')}
            class="field min-h-[6rem] w-full flex-1 resize-none px-4 py-3"></textarea>
          <p class="text-sm text-brand" data-form-error hidden></p>
          <!-- A tick box, and above the button rather than below it: this is the thing being agreed
               to, not a note about what happens afterwards. -->
          <label class="flex items-start gap-2 text-sm text-muted">
            <input type="checkbox" name="consent" required class="control" />
            <span>{t('sched.consentBefore')}<a class="text-foreground hover:text-brand" href={urlFor('privacy', locale)}>{t('sched.consentLink')}</a>.</span>
          </label>
          <div class="flex flex-wrap gap-3">
            <button type="submit" class="btn mono">{t('sched.send')}</button>
          </div>
        </form>

        <dialog data-step="done" class="req-done" aria-labelledby="done-heading">
          <button
            type="button"
            class="icon-btn absolute right-3 top-3"
            data-done-close
            aria-label={t('sched.close')}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
          <div class="grid gap-4">
            <p class="mono text-brand" id="done-heading">{t('sched.done.heading')}</p>
            <p class="max-w-[46ch] text-lg">{t('sched.done.thanks')}</p>
            <p class="max-w-[46ch] text-secondary" data-done-note></p>
            <p class="max-w-[46ch] text-secondary">
              {t('sched.done.next')}{site.meetingUrl ? t('sched.done.join') : ''}
            </p>
            <p class="mono text-muted" data-done-summary></p>
          </div>
        </dialog>
      </div>
    </div>
  </section>

  <script
    type="application/json"
    data-schedule-config
    set:html={JSON.stringify({
      types: sessionTypesFor(locale).map((session) => ({
        id: session.id,
        audience: session.audience,
        minutes: session.minutes,
        confirmation: session.confirmation
      })),
      timezone: availability.timezone,
      // The browser writes part of this page — the loading state, the error lines, the button while
      // it sends — so the words it needs travel with it, and the dates it formats use the page's
      // language rather than whatever the visitor's machine happens to be set to.
      intl: intlTagFor(locale),
      // Sent with the request so the emails it triggers can answer in the language it was asked in.
      locale,
      strings: {
        loading: t('sched.loading'),
        loadError: t('sched.loadError'),
        noTimes: t('sched.noTimes'),
        sending: t('sched.sending'),
        send: t('sched.send'),
        generic: t('sched.err.generic'),
        time: t('sched.err.time'),
        name: t('sched.err.name'),
        email: t('sched.err.email'),
        consent: t('sched.err.consent'),
        // Keyed by the code the API sends back, so a refusal from the server arrives in the
        // visitor's language like every other message on the page.
        slot_taken: t('sched.err.slotTaken'),
        slot_unavailable: t('sched.err.slotUnavailable'),
        already_pending: t('sched.err.alreadyPending'),
        unavailable: t('sched.err.unavailable')
      }
    })}
  ></script>
  <script>
    import '../../assets/js/schedule.js';
  </script>
