---
import { localeFromPath } from '../../i18n/config.mjs';
import { translator, fill } from '../../i18n/ui.mjs';
import { RETENTION_DAYS, BACKUP_DAYS } from '../../lib/retention.js';

// Reads the language from the path itself, exactly as Base does, so the component needs nothing
// passed to it and one file serves all three routes.
const t = translator(localeFromPath(Astro.url.pathname));
// The numbers come from the rule, not from the copy: change the retention and the sentence follows.
const retention = fill(t('privacy.retention.body'), { days: RETENTION_DAYS, backup: BACKUP_DAYS });
---

<!--
  The privacy page's body, with no layout of its own. Each route supplies Base, so the same markup
  serves every language and only the chrome around it changes.
-->
<section>
  <div class="px-[var(--pad)] py-14">
    <p class="mono text-brand">{t('privacy.eyebrow')}</p>
    <h1 class="page-title mt-4">{t('privacy.title')}</h1>
    <p class="mt-6 max-w-[52ch] text-secondary">{t('privacy.intro')}</p>
  </div>
</section>

<section>
  <div class="grid max-w-[70ch] gap-8 px-[var(--pad)] py-14">
    <div>
      <p class="mono text-muted">{t('privacy.collect')}</p>
      <p class="mt-3 text-secondary">{t('privacy.collect.body')}</p>
      <p class="text-secondary">{t('privacy.collect.when')}</p>
    </div>
    <div>
      <p class="mono text-muted">{t('privacy.why')}</p>
      <p class="mt-3 text-secondary">{t('privacy.why.body')}</p>
    </div>
    <div>
      <p class="mono text-muted">{t('privacy.where')}</p>
      <ul class="mt-3 grid gap-1 text-secondary">
        <li class="flex gap-3">
          <span class="text-brand">–</span>
          <span><span class="text-foreground">Cloudflare</span>: {t('privacy.cloudflare')}</span>
        </li>
        <li class="flex gap-3">
          <span class="text-brand">–</span>
          <span><span class="text-foreground">Resend</span>: {t('privacy.resend')}</span>
        </li>
      </ul>
    </div>
    <div>
      <p class="mono text-muted">{t('privacy.retention')}</p>
      <p class="mt-3 text-secondary">{retention}</p>
    </div>
    <div>
      <p class="mono text-muted">{t('privacy.removal')}</p>
      <p class="mt-3 text-secondary">{t('privacy.removal.body')}</p>
    </div>
    <div>
      <p class="mono text-muted">{t('privacy.cookies')}</p>
      <p class="mt-3 text-secondary">{t('privacy.cookies.body')}</p>
    </div>
  </div>
</section>
