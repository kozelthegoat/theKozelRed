---
import Recommendation from '../Recommendation.astro';
import { recommendationsFor, recommenderUrls, homeRecommendations } from '../../data/resume.js';
import { localeFromPath } from '../../i18n/config.mjs';
import { fill, translator } from '../../i18n/ui.mjs';

// Reads the language from the path itself, exactly as Base does, so one component serves all three
// routes. A translated quote keeps its English alongside, offered as "See original · English".
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const originalLabel = t('reco.seeOriginal');
const translationLabel = t('reco.seeTranslation');

// Mike leads: the one chosen for the homepage, and the strongest sentence for someone hiring.
// Everyone else keeps the order they are already in.
const [lead] = homeRecommendations;
const recos = recommendationsFor(locale);
const ordered = [
  ...recos.filter((r) => r.author === lead),
  ...recos.filter((r) => r.author !== lead)
];
---

<!--
  The page's body, with no layout of its own: each route supplies Base, so one implementation serves
  every language and only the chrome around it changes.
-->
<section>
  <div class="px-[var(--pad)] pt-14 pb-12">
    <p class="mono text-brand">{t('reco.eyebrow')}</p>
    <h1 class="page-title mt-4">{t('reco.title')}</h1>
    <p class="mt-6 max-w-[52ch] text-secondary">{t('reco.intro')}</p>
  </div>
</section>

<!--
  One quote at a time, chosen with the bullets below rather than by scrolling through them. It is a
  layer, not the page: the script reveals it, so a browser without JS — or a reader with motion
  reduced — gets the plain list underneath and nothing is lost.
-->
<section class="reco-slides" data-slides>
  <div class="reco-viewport">
    {
      ordered.map((r, i) => (
        <Recommendation
          quote={r.quote}
          original={r.original}
          originalLabel={originalLabel}
          translationLabel={translationLabel}
          author={r.author}
          url={recommenderUrls[r.author]}
          index={i}
          variant="slide"
        />
      ))
    }
  </div>
  <div class="reco-bullets" data-bullets>
    {
      ordered.map((r, i) => (
        <button
          type="button"
          class="reco-bullet"
          data-bullet={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={fill(t('reco.bullet'), { n: i + 1, total: ordered.length, author: r.author })}
        >
          {String(i + 1).padStart(2, '0')}
        </button>
      ))
    }
  </div>
</section>

<section class="reco-list">
  {
    ordered.map((r, i) => (
      <Recommendation
        quote={r.quote}
        original={r.original}
        originalLabel={originalLabel}
        translationLabel={translationLabel}
        author={r.author}
        url={recommenderUrls[r.author]}
        index={i}
        variant="list"
      />
    ))
  }
</section>

<script>
  import '../../assets/js/recommendations.js';
</script>
