---
// One recommendation, in the three places it is used: the pair on the homepage, the plain list on
// /recommendations/ that everyone gets, and the pinned crossfade layered on top of that list. Only
// the wrapper differs, so the variant decides it rather than each caller.
const { quote, author, url, index = 0, variant = 'list', original = null, originalLabel = '', translationLabel = '' } = Astro.props;
const slide = variant === 'slide';

// Only where a translation exists. On the English page the quote is the original, and on a page
// whose language has no translation yet the same is true, so there is nothing to toggle to.
const showOriginal = Boolean(original);
// The slide carries its decorative quote as a glyph of its own, so the swap must not add another.
const originalText = slide ? original : `“${original}”`;

const frame = slide
  ? []
  : variant === 'grid'
    ? [
        // No rule between the pair on a phone: they are the same two quotes, and the line only
        // separated them into a list. Side by side, from md, they still get their column rule.
        index >= 2 ? 'hair-t' : '',
        index % 2 === 1 ? 'hair-l-md' : ''
      ]
    : [index > 0 ? 'hair-t' : ''];

const wrapper = slide
  ? 'slide'
  : 'group relative p-[var(--pad)] transition-transform duration-300 ease-out hover:-translate-y-1';
---

<blockquote class:list={[wrapper, ...frame]}>
  {
    !slide && (
      <span
        class="pointer-events-none absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 bg-brand transition-transform duration-300 ease-out group-hover:scale-y-100"
      />
    )
  }
  {
    slide ? (
      <span class="slide-glyph" aria-hidden="true">
        “
      </span>
    ) : (
      <p class="mono text-muted">
        <span class="px-1 transition-colors duration-200 group-hover:bg-brand group-hover:text-on-brand">
          [{String(index + 1).padStart(2, '0')}]
        </span>
      </p>
    )
  }
  <p
    data-quote
    class:list={[
      slide ? 'slide-quote' : 'mt-5 max-w-[62ch] text-[0.95rem] leading-relaxed text-secondary'
    ]}
  >
    {slide ? quote : `“${quote}”`}
  </p>
  <cite class:list={[slide ? 'slide-cite' : 'mono mt-5 block not-italic text-muted']}>
    —{' '}
    {
      url ? (
        <a
          class="transition-colors hover:text-brand"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {author}
        </a>
      ) : (
        author
      )
    }
  </cite>
  {
    showOriginal && (
      <button
        type="button"
        class="reco-original mono"
        data-original={originalText}
        data-original-label={originalLabel}
        data-translation-label={translationLabel}
        aria-expanded="false"
      >
        {originalLabel}
      </button>
    )
  }
</blockquote>
