---
import { site } from '../data/site.js';
import { WEEKDAY_HUES } from '../data/palette.js';
import { publishedNotes } from '../lib/note-source.js';
import Cta from '../components/Cta.astro';
import '../styles/fonts.css';
import '../styles/global.css';

const {
  title = `${site.name} — ${site.role}`,
  description = `${site.name} — ${site.role}.`
} = Astro.props;
const year = new Date().getFullYear();
// The footer's Navigation block points at home sections, so it only belongs on home.
const isHome = Astro.url.pathname === '/';
// The Notes link appears with the first published note and not before: an empty archive behind a
// link is worse than no link, and this way nobody has to remember to add one.
const hasNotes = (await publishedNotes()).length > 0;
const ticker = ['Strategy', 'Operations', 'Production', 'Team building', 'Crisis Management'];
---
<!doctype html>
<html lang="en" data-hues={WEEKDAY_HUES.join(',')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="canonical" href={Astro.site?.href ?? 'https://kozel.red/'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fa3600" />
    <script is:inline src="/accent.js"></script>
  </head>
  <body>
    <div class="mx-auto min-h-screen max-w-[1680px] hair-l hair-r">
      <!-- ticker -->
      <div class="marquee hair-b py-3">
        <div class="marquee__track mono text-muted">
          {
            [...ticker, ...ticker].map((t) => (
              <span class="flex items-center gap-3 whitespace-nowrap">
                <span class="inline-block h-1 w-1 rounded-full bg-brand" />
                {t}
              </span>
            ))
          }
        </div>
      </div>

      <!-- header -->
      <header class="sticky top-0 z-20 hair-b bg-background/85 backdrop-blur">
        <div class="flex items-center justify-between gap-4 px-[var(--pad)] py-4">
          <a href="/" class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
              <rect x="3.5" y="3.5" width="13" height="13" fill="var(--brand)" transform="rotate(45 10 10)"></rect>
            </svg>
            <span class="text-[1.05rem] font-medium tracking-tight">{site.name}</span>
          </a>

          <nav class="mono hidden items-center gap-7 text-muted md:flex" aria-label="Primary">
            <a class="transition-colors hover:text-foreground" href="/#help">Expertise</a>
            <a class="transition-colors hover:text-foreground" href="/#experience">Experience</a>
            {hasNotes && <a class="transition-colors hover:text-foreground" href="/notes/">Notes</a>}
            <a class="transition-colors hover:text-foreground" href="/#contact">Contact</a>
          </nav>

          <Cta href="/schedule/" label="Schedule 1:1" variant="solid" />
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <!-- footer -->
      <footer>
        <div
          class:list={[
            'grid gap-8 p-[var(--pad)] sm:grid-cols-2',
            isHome ? 'md:grid-cols-4' : 'md:grid-cols-3'
          ]}
        >
          {
            isHome && (
              <div>
                <p class="mono text-muted">Navigation</p>
                <ul class="mt-4 grid gap-2 text-sm">
                  <li><a class="hover:text-brand" href="/#help">Expertise</a></li>
                  <li><a class="hover:text-brand" href="/#experience">Experience</a></li>
                  <li><a class="hover:text-brand" href="/#recommendations">Recommendations</a></li>
                  <li><a class="hover:text-brand" href="/#resume">Résumé</a></li>
                  {hasNotes && <li><a class="hover:text-brand" href="/notes/">Notes</a></li>}
                </ul>
              </div>
            )
          }
          <div>
            <p class="mono text-muted">Services</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li>
                <a class="hover:text-brand" href="/schedule/">Schedule 1:1</a>
                <ul class="mt-2 ml-3 grid gap-1 text-muted">
                  <li class="flex gap-2"><span class="text-brand">–</span><span>Intro Call</span></li>
                  <li class="flex gap-2"><span class="text-brand">–</span><span>Career Review</span></li>
                  <li class="flex gap-2"><span class="text-brand">–</span><span>Working Session</span></li>
                </ul>
              </li>
            </ul>
          </div>
          <div>
            <p class="mono text-muted">Location</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li class="whitespace-pre-line text-muted">{site.location}</li>
            </ul>
          </div>
          <div>
            <p class="mono text-muted">Resources</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href={site.resume} download>Download Résumé</a></li>
            </ul>
            <p class="mono mt-6 text-muted">Legal</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href="/privacy/">View Privacy</a></li>
            </ul>
          </div>
        </div>

        <div class="mono flex flex-col gap-1 px-[var(--pad)] py-5 text-muted">
          <div class="grid w-fit grid-cols-[auto_auto] gap-x-3 gap-y-1">
            <span>© {site.name}</span>
            <span>| {site.renameYear} …</span>
            <span>© {site.previousName}</span>
            <span>| {site.bornYear} – {site.renameYear}</span>
          </div>
        </div>
      </footer>
    </div>

    {
      site.donateUrl && (
        <a class="btn btn--solid mono fixed bottom-6 right-6 z-30 shadow-xl" href={site.donateUrl} target="_blank" rel="noopener noreferrer">
          Donate
        </a>
      )
    }
    <script>
      import '../assets/js/reveal.js';
    </script>
  </body>
</html>
