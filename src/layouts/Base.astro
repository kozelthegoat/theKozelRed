---
import { site, nameFor } from '../data/site.js';
import { sessionTypes } from '../data/sessions.js';
import { WEEKDAY_HUES } from '../data/palette.js';
import { publishedNotes } from '../lib/note-source.js';
import { dirFor, localeFromPath, pathInLocale, prefixFor } from '../i18n/config.mjs';
import { alternatesForPath, pageKeyForPath } from '../i18n/pages.mjs';
import { lookup, translator } from '../i18n/ui.mjs';
import Cta from '../components/Cta.astro';
import LocaleSwitcher from '../components/LocaleSwitcher.astro';
import '../styles/fonts.css';
import '../styles/global.css';

const {
  title: explicitTitle,
  description: explicitDescription,
  // A page can name its own languages — a note varies per slug — and otherwise the registry knows.
  // Null means nothing to switch to, so the menu never offers a link that isn't there.
  alternates: explicitAlternates = null
} = Astro.props;

const alternates = explicitAlternates ?? alternatesForPath(Astro.url.pathname);

// The language comes from the URL, never a cookie: a prefixed path is self-describing, so every
// locale is shareable and indexable and nothing has to be remembered between visits.
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);

// Named from the registry and the dictionary, not from the route file that renders the page. The
// three wrappers that serve one page in three languages used to each carry the same English title,
// so /ru/privacy/ had a translated body under an English <title>. A note names itself, so it still
// passes one; everything else resolves from the path.
const pageKey = pageKeyForPath(Astro.url.pathname);
const title = explicitTitle ?? (pageKey && lookup(locale, `page.${pageKey}`)) ?? `${nameFor(locale)} — ${site.role}`;
const description =
  explicitDescription ?? (pageKey && lookup(locale, `page.${pageKey}.description`)) ?? `${nameFor(locale)} — ${site.role}.`;
const year = new Date().getFullYear();
// The footer's Navigation block points at home sections, so it only belongs on the English home.
const isHome = Astro.url.pathname === '/';
// The Notes link appears with the first published note in this language and not before: an empty
// archive behind a link is worse than no link, and this way nobody has to remember to add one.
const hasNotes = (await publishedNotes(locale)).length > 0;
const origin = Astro.site ?? new URL('https://kozel.red');
const canonical = new URL(Astro.url.pathname, origin).href;
---
<!doctype html>
<html
  lang={locale}
  dir={dirFor(locale)}
  data-hues={WEEKDAY_HUES.join(',')}
  data-ribbon-dismissible={site.ribbonDismissible ? 'true' : 'false'}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <!-- This used to point at the site root on every page, which told search engines that every
         page was a duplicate of the homepage. It now names the page it is on. -->
    <link rel="canonical" href={canonical} />
    {
      alternates?.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate}
          href={new URL(pathInLocale(Astro.url.pathname, alternate), origin).href}
        />
      ))
    }
    {
      alternates && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(pathInLocale(Astro.url.pathname, 'en'), origin).href}
        />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fa3600" />
    <script is:inline src="/accent.js"></script>
    <script is:inline src="/ribbon.js"></script>
  </head>
  <body>
    <!-- Keyboard users reach the content before the ticker and the navigation. It stays out of
         sight until it is focused, which is the only time it is useful. -->
    <a class="skip-link mono" href="#main">Skip to content</a>
    <div class="mx-auto min-h-screen max-w-[1680px] hair-l hair-r">
      <!-- The masthead quote. It does not move, so there is nothing to pause; the dismiss control
           exists but is switched off in site.js until this space carries an announcement. -->
      <div class="ribbon" data-ribbon>
        <p class="mono text-balance tracking-[0.02em] text-muted">{t('ribbon.line')}</p>
        {
          site.ribbonDismissible && (
            <button type="button" class="ribbon-close" data-ribbon-close aria-label={t('ribbon.dismiss')}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" />
              </svg>
            </button>
          )
        }
      </div>

      <!-- header -->
      <header class="sticky top-0 z-20 bg-background/85 backdrop-blur">
        <div class="flex items-center justify-between gap-4 px-[var(--pad)] py-4">
          <a href="/" class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
              <rect x="3.5" y="3.5" width="13" height="13" fill="var(--brand)" transform="rotate(45 10 10)"></rect>
            </svg>
            <span class="text-[1.05rem] font-medium tracking-tight">{nameFor(locale)}</span>
          </a>

          <!--
            Expertise, Experience and Pro Bono point at sections of the home page, which exist
            there and nowhere else. The header offers them only on the home page, where the links
            land; the footer's Navigation column is on every page, and its absolute /#… links
            navigate home first.
          -->
          {
            (isHome || hasNotes) && (
              <nav class="mono hidden items-center gap-7 text-muted lg:flex" aria-label="Primary">
                {isHome && (
                  <a class="transition-colors hover:text-foreground" href="/#expertise">{t('nav.expertise')}</a>
                )}
                {isHome && (
                  <a class="transition-colors hover:text-foreground" href="/#experience">{t('nav.experience')}</a>
                )}
                {isHome && (
                  <a class="transition-colors hover:text-foreground" href="/#recommendations">{t('footer.recommendations')}</a>
                )}
                {
                  hasNotes && (
                    <a class="transition-colors hover:text-foreground" href={`${prefixFor(locale)}/notes/`}>
                      {t('nav.notes')}
                    </a>
                  )
                }
                {isHome && (
                  <a class="transition-colors hover:text-foreground" href="/#pro-bono">{t('footer.proBono')}</a>
                )}
              </nav>
            )
          }

          <Cta href="/schedule/" label={t('cta.schedule')} variant="solid" />
        </div>
      </header>

      <main id="main" tabindex="-1">
        <slot />
      </main>

      <!-- footer -->
      <footer>
        <div class="grid gap-8 p-[var(--pad)] sm:grid-cols-2 md:grid-cols-4">
          <div>
            <p class="mono text-muted">{t('footer.navigation')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href="/#expertise">{t('nav.expertise')}</a></li>
              <li><a class="hover:text-brand" href="/#experience">{t('nav.experience')}</a></li>
              <li><a class="hover:text-brand" href="/#recommendations">{t('footer.recommendations')}</a></li>
              <li><a class="hover:text-brand" href="/#pro-bono">{t('footer.proBono')}</a></li>
              {
                hasNotes && (
                  <li><a class="hover:text-brand" href={`${prefixFor(locale)}/notes/`}>{t('footer.notes')}</a></li>
                )
              }
            </ul>
          </div>
          <div>
            <p class="mono text-muted">{t('footer.proBono')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li>
                <a class="hover:text-brand" href="/schedule/">{t('footer.schedule')}</a>
                <ul class="mt-2 ml-3 grid gap-1 text-muted">
                  {
                    sessionTypes.map((s) => (
                      <li class="flex gap-2">
                        <span class="text-brand">–</span>
                        <span>{s.audience}</span>
                      </li>
                    ))
                  }
                </ul>
              </li>
            </ul>
          </div>
          <div>
            <p class="mono text-muted">{t('footer.location')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li class="whitespace-pre-line text-muted">{site.location}</li>
            </ul>
            <p class="mono mt-6 text-muted">{t('footer.availability')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              {
                site.availability.map((item) => (
                  <li class="flex gap-2 text-muted">
                    <span class="text-brand">–</span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="mono text-muted">{t('footer.resources')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href={site.resume} download>{t('cta.resume')}</a></li>
            </ul>
            <p class="mono mt-6 text-muted">{t('footer.legal')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href="/privacy/">{t('footer.privacy')}</a></li>
            </ul>
            <p class="mono mt-6 text-muted">{t('footer.contacts')}</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li>
                <a class="hover:text-brand" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
              </li>
            </ul>
          </div>
        </div>

        {
          alternates?.length > 1 && (
            <div class="px-[var(--pad)] pb-5">
              <LocaleSwitcher alternates={alternates} />
            </div>
          )
        }

        <div class="mono flex flex-col gap-1 px-[var(--pad)] py-5 text-muted">
          <div class="grid w-fit grid-cols-[auto_auto] gap-x-3 gap-y-1">
            <span>© {nameFor(locale)}</span>
            <span>| {site.renameYear} …</span>
            <span>© {site.previousName}</span>
            <span>| {site.bornYear} – {site.renameYear}</span>
          </div>
        </div>
      </footer>
    </div>

    {
      site.donateUrl && (
        <a class="btn btn--solid mono fixed bottom-6 right-6 z-30 shadow-xl" href={site.donateUrl} target="_blank" rel="noopener noreferrer">
          {t('cta.donate')}
        </a>
      )
    }
    <script>
      import '../assets/js/reveal.js';
      import '../assets/js/press.js';
    </script>
  </body>
</html>
