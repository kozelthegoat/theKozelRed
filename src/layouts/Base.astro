---
import { site } from '../data/site.js';
import '../styles/global.css';

const {
  title = `${site.name} — ${site.role}`,
  description = `${site.name} — ${site.role}.`
} = Astro.props;
const year = new Date().getFullYear();
const ticker = ['Operations', 'Production', 'Studio leadership', 'Risk & crisis', 'Team building'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={Astro.site?.href ?? 'https://kozel.red/'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="mx-auto min-h-screen max-w-[1680px] hair-l hair-r">
      <!-- ticker -->
      <div class="marquee hair-b py-3">
        <div class="marquee__track mono text-muted">
          {
            [...ticker, ...ticker].map((t) => (
              <span class="flex items-center gap-3 whitespace-nowrap">
                <span class="inline-block h-1 w-1 rounded-full bg-brand" />
                {t}
              </span>
            ))
          }
        </div>
      </div>

      <!-- header -->
      <header class="sticky top-0 z-20 hair-b bg-background/85 backdrop-blur">
        <div class="flex items-center justify-between gap-4 px-[var(--pad)] py-4">
          <a href="/" class="flex items-center gap-3">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
              <rect x="3.5" y="3.5" width="13" height="13" fill="#fa3600" transform="rotate(45 10 10)"></rect>
            </svg>
            <span class="text-[1.05rem] font-medium tracking-tight">{site.name}</span>
          </a>

          <nav class="mono hidden items-center gap-7 text-muted md:flex" aria-label="Primary">
            <a class="transition-colors hover:text-foreground" href="/#help">What I Can Help</a>
            <a class="transition-colors hover:text-foreground" href="/#experience">Experience</a>
            <a class="transition-colors hover:text-foreground" href="/#contact">Contact</a>
          </nav>

          <a class="btn btn--solid mono" href="/schedule/">
            <span>Schedule a 1:1</span>
            <svg class="arrow" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M11.875 14.375L16.25 9.93818L11.875 5.625M16.25 9.93818H2.5" stroke="currentColor" stroke-width="1.5"></path>
            </svg>
          </a>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <!-- footer -->
      <footer class="hair-t">
        <div class="grid gap-8 p-[var(--pad)] sm:grid-cols-2 md:grid-cols-4">
          <div>
            <p class="mono text-muted">Navigate</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href="/#help">What I Can Help</a></li>
              <li><a class="hover:text-brand" href="/#experience">Experience</a></li>
              <li><a class="hover:text-brand" href="/#recommendations">Recommendations</a></li>
              <li><a class="hover:text-brand" href="/#resume">Résumé</a></li>
            </ul>
          </div>
          <div>
            <p class="mono text-muted">1:1</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href="/schedule/">Schedule a 1:1</a></li>
              <li class="text-muted">Intro call — 30 min</li>
              <li class="text-muted">Deep-dive — 60 min</li>
            </ul>
          </div>
          <div>
            <p class="mono text-muted">Contact</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href={`mailto:${site.email}`}>{site.email}</a></li>
              <li class="text-muted">{site.location}</li>
            </ul>
          </div>
          <div>
            <p class="mono text-muted">Résumé</p>
            <ul class="mt-4 grid gap-2 text-sm">
              <li><a class="hover:text-brand" href={site.resume}>Download PDF</a></li>
            </ul>
          </div>
        </div>

        <div class="hair-t mono flex flex-wrap items-center justify-between gap-3 px-[var(--pad)] py-5 text-muted">
          <span>© {year} {site.name}</span>
          <span>{site.altName}</span>
        </div>
      </footer>
    </div>

    {
      site.donateUrl && (
        <a class="btn btn--solid mono fixed bottom-6 right-6 z-30 shadow-xl" href={site.donateUrl} target="_blank" rel="noopener noreferrer">
          Donate
        </a>
      )
    }
  </body>
</html>
